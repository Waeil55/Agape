{
	"appId": "com.agapecare.fleet",
	"appName": "Agape Care",
	"webDir": "dist",
	"backgroundColor": "#2A52AC",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"useLegacyBridge": true
	},
	"plugins": {
		"Geolocation": {
			"permissions": "always"
		},
		"Keyboard": {
			"resize": "none",
			"resizeOnFullScreen": false
		}
	},
	"packageClassList": [
		"ActionSheetPlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"DevicePlugin",
		"DialogPlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"KeyboardPlugin"
	]
}
