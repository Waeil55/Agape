rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function allowedChatUploadType() {
      return request.resource.contentType.matches(
        'image/.*|application/pdf|text/plain|text/csv|application/msword|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.*'
      );
    }

    match /chat_uploads/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && allowedChatUploadType();
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
