rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() {
      return accountExists()
        && currentProfile().get('disabled', false) != true
        && currentProfile().get('active', true) != false
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'disabled'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'inactive'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'revoked'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'suspended'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'terminated'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'separated';
    }
    function isAdmin() {
      return signedIn() && currentProfile().role == 'admin';
    }
    function isDispatcher() {
      let role = currentProfile().role;
      return signedIn() && (role == 'admin' || role == 'dispatcher');
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    // Upload/assignment scope for trip writes (least privilege).
    // Admins and dispatchers (server-known roles) keep full write access;
    // dispatcher-to-driver scoping is enforced client-side (App.jsx
    // uploadScope + handleUploadedTrips gate) because the dispatcher identity
    // is email-matched and not resolvable to a profile ID inside rules.
    // Drivers may only write trips tagged to themselves: the write must carry
    // their own auth email, and any assigned driverId must resolve to a driver
    // profile with that same email (or not exist yet for syncing profiles).
    // Legacy updates without driverEmail still pass when the stored driverId
    // resolves to the writer's own email.
    function tripWriterEmail() {
      return request.auth.token.email;
    }
    function tripDriverIdMatchesWriter(driverId) {
      return driverId == null
        || driverId == ''
        || !exists(/databases/$(database)/documents/drivers/$(driverId))
        || get(/databases/$(database)/documents/drivers/$(driverId)).data.email == tripWriterEmail();
    }
    function tripSelfCreate() {
      let data = request.resource.data;
      return data.get('driverEmail', null) == tripWriterEmail()
        && tripDriverIdMatchesWriter(data.get('driverId', null));
    }
    function tripSelfUpdate() {
      let data = request.resource.data;
      let old = resource.data;
      return (!tripHasPendingTransfer(old) && (
          data.get('driverEmail', null) == tripWriterEmail()
          || old.get('driverEmail', null) == tripWriterEmail()
          || (old.get('driverId', null) != null
            && old.get('driverId', null) != ''
            && exists(/databases/$(database)/documents/drivers/$(old.driverId))
            && get(/databases/$(database)/documents/drivers/$(old.driverId)).data.email == tripWriterEmail())
        ))
        || tripTransferRecipientUpdate();
    }
    function tripHasPendingTransfer(trip) {
      let transfer = trip.get('transferRequest', {});
      return transfer is map
        && transfer.get('status', '') is string
        && transfer.get('status', '').lower() == 'pending';
    }
    function strictTransferDriverIdMatchesWriter(driverId) {
      return driverId is string
        && driverId != ''
        && (
          currentProfile().get('profileId', '') == driverId
          || (exists(/databases/$(database)/documents/driverProfiles/$(driverId))
            && get(/databases/$(database)/documents/driverProfiles/$(driverId)).data.get('email', '') is string
            && get(/databases/$(database)/documents/driverProfiles/$(driverId)).data.get('email', '').lower() == tripWriterEmail().lower())
          || (exists(/databases/$(database)/documents/drivers/$(driverId))
            && get(/databases/$(database)/documents/drivers/$(driverId)).data.get('email', '') is string
            && get(/databases/$(database)/documents/drivers/$(driverId)).data.get('email', '').lower() == tripWriterEmail().lower())
        );
    }
    function transferRequestTargetsWriter(transfer) {
      let targetEmail = transfer.get('toDriverEmail', '');
      let targetId = transfer.get('toDriverId', '');
      return tripWriterEmail() is string
        && targetEmail is string
        && targetId is string
        && (targetEmail != '' || targetId != '')
        // When both identifiers are stored they must agree. A conflicting
        // request is ambiguous and therefore fails closed.
        && (targetEmail == '' || targetEmail.lower() == tripWriterEmail().lower())
        && (targetId == '' || strictTransferDriverIdMatchesWriter(targetId));
    }
    function transferReturnsStoredWorkflow(data, transfer) {
      let previous = transfer.get('previousStatus', '');
      let resumable = [
        'assigned', 'in mission', 'en route', 'in progress',
        'navigating pickup', 'at pickup', 'in transit',
        'navigating dropoff', 'at dropoff', 'arrived'
      ];
      return previous is string
        && data.get('status', '') is string
        && (
          (previous.lower() in resumable && data.get('status', '').lower() == previous.lower())
          || (!(previous.lower() in resumable) && data.get('status', '') == 'Assigned')
        );
    }
    function validTransferLifecycle(data) {
      let status = data.get('status', '');
      let inProgress = [
        'assigned', 'in mission', 'in progress', 'navigating pickup',
        'at pickup', 'in transit', 'navigating dropoff', 'at dropoff', 'arrived'
      ];
      return status is string
        && (
          (status.lower() in inProgress
            && data.get('lifecycleStatus', '') == 'in_progress'
            && data.get('operationalStatus', '') == 'in_progress')
          // Legacy En Route is resumable but predates the in-progress
          // lifecycle vocabulary, so the authoritative builder classifies it
          // as assigned while its workflow step remains resumable.
          || (status.lower() == 'en route'
            && data.get('lifecycleStatus', '') == 'assigned'
            && data.get('operationalStatus', '') == 'assigned')
        )
        && data.get('lifecycleStep', '') in [
          'assigned', 'accepted', 'navigating_pickup', 'arrived_pickup',
          'picked_up', 'navigating_dropoff', 'arrived_dropoff'
        ];
    }
    function validTransferPersistenceMetadata(data, changed) {
      return changed.hasAll([
          'workflowUpdatedAt', 'updatedAtLocal', 'lifecycleStatus',
          'lifecycleStep', 'operationalStatus', 'updatedAt', 'syncedAt',
          'syncedAtLocal'
        ])
        && data.get('workflowUpdatedAt', '') is string
        && data.get('workflowUpdatedAt', '').size() >= 20
        && data.get('updatedAtLocal', '') == data.get('workflowUpdatedAt', '')
        && data.get('syncedAtLocal', '') is string
        && data.get('syncedAtLocal', '').size() >= 20
        && data.get('updatedAt', null) == request.time
        && data.get('syncedAt', null) == request.time
        && validTransferLifecycle(data);
    }
    function validAcceptedTransferIdentity(data, old, transfer) {
      let targetId = transfer.get('toDriverId', '');
      return data.get('transferStatus', '') == 'accepted'
        && data.get('driverId', '') is string
        && strictTransferDriverIdMatchesWriter(data.get('driverId', ''))
        && (targetId == '' || data.get('driverId', '') == targetId)
        && data.get('driverEmail', '') is string
        && data.get('driverEmail', '').lower() == tripWriterEmail().lower()
        && data.get('driverName', '') is string
        && data.get('driverName', '').size() > 0;
    }
    function validDeclinedTransferIdentity(data, old) {
      return data.get('transferStatus', '') == 'declined'
        && data.get('driverId', null) == old.get('driverId', null)
        && data.get('driverEmail', null) == old.get('driverEmail', null)
        && data.get('driverName', null) == old.get('driverName', null);
    }
    // A pending transfer gives its exact recipient permission for one narrow
    // accept/decline transition only. The recipient cannot edit workflow,
    // odometer, assignment, or request evidence outside this decision.
    function tripTransferRecipientUpdate() {
      let data = request.resource.data;
      let old = resource.data;
      let transfer = old.get('transferRequest', {});
      let decision = data.get('transferRequest', {});
      let changed = data.diff(old).affectedKeys();
      return transfer is map
        && decision is map
        && tripHasPendingTransfer(old)
        && old.get('status', '') is string
        && old.get('status', '').lower() == 'transferred'
        && transferRequestTargetsWriter(transfer)
        && changed.hasAll(['status', 'transferStatus', 'transferRequest'])
        && changed.hasOnly([
          'status', 'driverId', 'driverEmail', 'driverName',
          'transferStatus', 'transferRequest', 'workflowUpdatedAt',
          'updatedAtLocal', 'lifecycleStatus', 'lifecycleStep',
          'operationalStatus', 'updatedAt', 'syncedAt', 'syncedAtLocal'
        ])
        && decision.diff(transfer).affectedKeys().hasAll(['status', 'decidedAt', 'decidedBy'])
        && decision.diff(transfer).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
        && decision.get('status', '') in ['accepted', 'declined']
        && data.get('transferStatus', '') == decision.get('status', '')
        && decision.get('decidedAt', '') is string
        && decision.get('decidedAt', '').size() >= 20
        && decision.get('decidedBy', '') is string
        && decision.get('decidedBy', '').lower() == tripWriterEmail().lower()
        && transferReturnsStoredWorkflow(data, transfer)
        && validTransferPersistenceMetadata(data, changed)
        && (
          (decision.get('status', '') == 'accepted'
            && validAcceptedTransferIdentity(data, old, transfer))
          || (decision.get('status', '') == 'declined'
            && validDeclinedTransferIdentity(data, old))
        );
    }
    function validOverrideCostPolicy() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'unloadedThresholdMiles', 'unloadedRate', 'sameCityExemption', 'sameCityNames',
          'waitingThresholdHours', 'waitRate', 'waitRoundingMinutes', 'excludeOvernightGaps',
          'excludedCityPairs', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'homeAddress', 'homeAddress2', 'homeCity', 'homeState', 'homeZip',
          'homeLat', 'homeLng', 'homeFormattedAddress',
          'unloadedThresholdMiles', 'unloadedRate', 'sameCityExemption', 'sameCityNames',
          'waitingThresholdHours', 'waitRate', 'waitRoundingMinutes', 'excludeOvernightGaps',
          'excludedCityPairs', 'overrideExclusionRules', 'updatedAt', 'updatedBy'
        ])
        && data.get('homeAddress', '') is string && data.get('homeAddress', '').size() <= 240
        && data.get('homeAddress2', '') is string && data.get('homeAddress2', '').size() <= 120
        && data.get('homeCity', '') is string && data.get('homeCity', '').size() <= 100
        && data.get('homeState', '') is string && data.get('homeState', '').size() <= 2
        && data.get('homeZip', '') is string && data.get('homeZip', '').size() <= 10
        && data.get('homeFormattedAddress', '') is string && data.get('homeFormattedAddress', '').size() <= 320
        && (data.get('homeLat', null) == null
          || (data.homeLat is number && data.homeLat >= -90 && data.homeLat <= 90))
        && (data.get('homeLng', null) == null
          || (data.homeLng is number && data.homeLng >= -180 && data.homeLng <= 180))
        && data.unloadedThresholdMiles is number && data.unloadedThresholdMiles >= 0
        && data.unloadedRate is number && data.unloadedRate >= 0
        && data.sameCityExemption is bool && data.sameCityNames is list && data.sameCityNames.size() <= 100
        && data.waitingThresholdHours is number && data.waitingThresholdHours >= 0
        && data.waitRate is number && data.waitRate >= 0
        && data.waitRoundingMinutes is number && data.waitRoundingMinutes >= 1
        && data.excludeOvernightGaps is bool && data.excludedCityPairs is list && data.excludedCityPairs.size() <= 200
        && data.get('overrideExclusionRules', []) is list && data.get('overrideExclusionRules', []).size() <= 200
        && data.updatedAt is string && data.updatedBy == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'settings', 'profileId', 'email', 'fcmToken', 'lastSeenAt', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /deleted_user_tombstones/{userId} {
      // Server-only employment identity ledger. Prevents a deleted account from
      // being silently recreated by profile synchronization or a stale client.
      allow read, create, update, delete: if false;
    }
    match /routeData/{document} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /appData/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isDispatcher() || tripSelfCreate());
      allow update: if signedIn() && (isDispatcher() || tripSelfUpdate());
      allow delete: if signedIn() && isAdmin();
    }
    match /clientProfiles/{profileId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow create: if signedIn() && isDispatcher();
      allow update: if signedIn() && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || request.resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || request.resource.data.driverId == request.auth.uid
      );
      allow delete: if signedIn() && isDispatcher();
    }
    match /sessions/{sessionId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow delete: if signedIn() && isAdmin();
    }
    match /heartbeat/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /driver_locations/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /system_events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }

    match /audit_logs/{auditId} {
      allow read: if signedIn() && isDispatcher();
      // Immutable server-authored evidence. Cloud Functions/Admin SDK bypass
      // client rules; browsers must never forge, rewrite, or erase audit data.
      allow create, update, delete: if false;
    }
    match /tripLedger/{tripId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /driverTripProgress/{tripId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /driverProfiles/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /dispatcherProfiles/{dispatcherId} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdmin() || isOwner(dispatcherId));
    }
    match /fleetVehicles/{vehicleId} {
      allow read: if signedIn();
      allow write: if signedIn() && isDispatcher();
    }
    match /systemConfig/{document} {
      allow read: if signedIn() && (isDispatcher() || document == 'phoneNumbers');
      allow create, update: if (document == 'overrideCostPolicy' && isDispatcher() && validOverrideCostPolicy())
        || (document != 'overrideCostPolicy' && isAdmin());
      allow delete: if isAdmin();
    }
    match /smsLogs/{messageId} {
      // Telnyx bodies are server-authored business communications. They may
      // contain sensitive client replies and are visible only to admins and
      // dispatchers; drivers use their phone's native Messages app instead.
      allow read: if signedIn() && isDispatcher();
      allow create, update, delete: if false;
    }
    match /smsConversations/{conversationId} {
      allow read, create, update, delete: if false;
    }
    match /smsOptOuts/{conversationId} {
      allow read, create, update, delete: if false;
    }
    match /smsSendRequests/{requestId} {
      allow read, create, update, delete: if false;
    }
    match /welltrans_settings/{document} {
      allow read: if signedIn() && isDispatcher();
      allow create, update: if signedIn() && isAdmin()
        && !request.resource.data.keys().hasAny([
          'portalUsername',
          'portalPassword',
          'password',
          'credentials',
          'token',
          'accessToken',
          'refreshToken'
        ]);
      allow delete: if false;
    }
    match /welltrans_sync_logs/{logId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_sync_events/{eventId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_verification_runs/{runId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_correction_commands/{commandId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_sync_manifests/{serviceDate} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_driver_sync_status/{driverRunId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_sync_shards/{shardId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_sync_outbox/{outboxId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_sync_leases/{serviceDate} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_worker_status/{workerId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_workers/{workerInstanceId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_operations/{document} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_canary/{document} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_canary_history/{document} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /welltrans_review_confirmations/{confirmationId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if false;
    }
    match /drivers/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }

    match /presence/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && userEmail() == email;
    }

    match /chat_presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /driverTelemetry/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /analyticsLogs/{logId} {
      allow read: if signedIn() && isDispatcher();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // AI Dispatch + Time Tracking System — Section 10: real-time shift event log
    match /shiftEvents/{eventId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // Section 10: GAP audit log — every gap generates a mandatory record
    match /gapAuditLog/{gapId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // Section 18: Finalized time tracking sessions with payroll output
    match /timeTrackingSessions/{sessionId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || resource.data.driverId == request.auth.uid);
      allow delete: if signedIn() && isAdmin();
    }
    // Immutable payroll-gap decisions. Only authorized payroll reviewers may
    // create a decision; corrections create a new record instead of rewriting history.
    match /timeTrackingGapReviews/{reviewId} {
      allow read: if signedIn() && isDispatcher();
      allow create: if signedIn() && isDispatcher()
        && request.resource.data.driverId is string
        && request.resource.data.date is string
        && request.resource.data.resolution in ['PAID_WAITING', 'PERSONAL_UNPAID']
        && request.resource.data.correctionReason is string
        && request.resource.data.correctionReason.size() >= 3
        && request.resource.data.correctedBy == request.auth.token.email;
      allow update, delete: if false;
    }
    // Driver declarations are append-only and server-timestamped. They can only
    // reduce/segment claimed time; drivers cannot rewrite or erase the ledger.
    match /timeTrackingDeclarations/{declarationId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.driverEmail == request.auth.token.email
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.type in ['BREAK_START', 'BREAK_END']
        && request.resource.data.reason in ['PERSONAL_UNAVAILABLE', 'RETURNED_TO_WORK']
        && request.resource.data.source == 'driver_personal_declaration'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Driver-submitted notes and correction requests preserve the original
    // time snapshot. Only authorized reviewers may add a disposition.
    match /timeTrackingCorrectionRequests/{requestId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.driverEmail == request.auth.token.email
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.date is string
        && request.resource.data.requestType in ['INCORRECT_TIME', 'MISSING_START', 'MISSING_END', 'SHIFT_NOTE']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'driver_same_view_request'
        && request.resource.data.originalSnapshot is map
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && isDispatcher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewerNote', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.status in ['resolved', 'rejected']
        && request.resource.data.reviewerNote is string
        && request.resource.data.reviewerNote.size() >= 3
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // Approved payroll records (admin/dispatcher finalize, driver can read own)
    match /payrollRecords/{recordId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn() && isDispatcher();
      allow update: if signedIn() && isAdmin();
      allow delete: if signedIn() && isAdmin();
    }

    // Real-time Chat System Rules (Facebook Messenger Backend)
    match /chat_channels/{channelId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'readBy', 'unreadCounts', 'typing', 'mutedBy']);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 50 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['direct', 'group'];
      allow delete: if signedIn() && isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 10000 &&
          (!request.resource.data.keys().hasAny(['forwardedFrom']) ||
            request.resource.data.forwardedFrom.channelId is string);
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'deletedAt', 'deletedBy', 'reactions', 'pinned', 'pinnedBy', 'pinnedAt']) &&
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned', 'pinnedBy', 'pinnedAt']) || request.auth.uid == resource.data.senderId);
        allow delete: if signedIn() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
