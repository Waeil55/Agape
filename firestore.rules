rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() {
      return accountExists()
        && currentProfile().get('disabled', false) != true
        && currentProfile().get('active', true) != false
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'disabled'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'inactive'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'revoked'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'suspended'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'terminated'
        && currentProfile().get('accessStatus', currentProfile().get('employmentStatus', 'active')) != 'separated';
    }
    function isAdmin() {
      return signedIn() && currentProfile().role == 'admin';
    }
    function isDispatcher() {
      let role = currentProfile().role;
      return signedIn() && (role == 'admin' || role == 'dispatcher');
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'settings', 'profileId', 'email', 'fcmToken', 'lastSeenAt', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /deleted_user_tombstones/{userId} {
      // Server-only employment identity ledger. Prevents a deleted account from
      // being silently recreated by profile synchronization or a stale client.
      allow read, create, update, delete: if false;
    }
    match /routeData/{document} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /appData/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow create: if signedIn() && isDispatcher();
      allow update: if signedIn() && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || request.resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || request.resource.data.driverId == request.auth.uid
      );
      allow delete: if signedIn() && isDispatcher();
    }
    match /sessions/{sessionId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow delete: if signedIn() && isAdmin();
    }
    match /heartbeat/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /driver_locations/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /system_events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }

    match /audit_logs/{auditId} {
      allow read: if signedIn() && isDispatcher();
      // Immutable server-authored evidence. Cloud Functions/Admin SDK bypass
      // client rules; browsers must never forge, rewrite, or erase audit data.
      allow create, update, delete: if false;
    }
    match /tripLedger/{tripId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /driverTripProgress/{tripId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /driverProfiles/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }
    match /dispatcherProfiles/{dispatcherId} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdmin() || isOwner(dispatcherId));
    }
    match /fleetVehicles/{vehicleId} {
      allow read: if signedIn();
      allow write: if signedIn() && isDispatcher();
    }
    match /systemConfig/{document} {
      allow read: if signedIn() && (isDispatcher() || document == 'phoneNumbers');
      allow write: if signedIn() && isAdmin();
    }
    match /welltrans_settings/{document} {
      allow read: if signedIn() && isAdmin();
      allow create, update: if signedIn() && isAdmin()
        && !request.resource.data.keys().hasAny([
          'portalUsername',
          'portalPassword',
          'password',
          'credentials',
          'token',
          'accessToken',
          'refreshToken'
        ]);
      allow delete: if false;
    }
    match /welltrans_sync_logs/{logId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_sync_events/{eventId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_verification_runs/{runId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_correction_commands/{commandId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_sync_manifests/{serviceDate} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_driver_sync_status/{driverRunId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_sync_shards/{shardId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_sync_outbox/{outboxId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_sync_leases/{serviceDate} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_worker_status/{workerId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_workers/{workerInstanceId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_operations/{document} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_canary/{document} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /welltrans_canary_history/{document} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }
    match /drivers/{driverId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if signedIn() && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if signedIn() && isAdmin();
    }

    match /presence/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && userEmail() == email;
    }

    match /chat_presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /driverTelemetry/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /analyticsLogs/{logId} {
      allow read: if signedIn() && isDispatcher();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // AI Dispatch + Time Tracking System — Section 10: real-time shift event log
    match /shiftEvents/{eventId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // Section 10: GAP audit log — every gap generates a mandatory record
    match /gapAuditLog/{gapId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn() && isAdmin();
    }
    // Section 18: Finalized time tracking sessions with payroll output
    match /timeTrackingSessions/{sessionId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || resource.data.driverId == request.auth.uid);
      allow delete: if signedIn() && isAdmin();
    }
    // Immutable payroll-gap decisions. Only authorized payroll reviewers may
    // create a decision; corrections create a new record instead of rewriting history.
    match /timeTrackingGapReviews/{reviewId} {
      allow read: if signedIn() && isDispatcher();
      allow create: if signedIn() && isDispatcher()
        && request.resource.data.driverId is string
        && request.resource.data.date is string
        && request.resource.data.resolution in ['PAID_WAITING', 'PERSONAL_UNPAID']
        && request.resource.data.correctionReason is string
        && request.resource.data.correctionReason.size() >= 3
        && request.resource.data.correctedBy == request.auth.token.email;
      allow update, delete: if false;
    }
    // Driver declarations are append-only and server-timestamped. They can only
    // reduce/segment claimed time; drivers cannot rewrite or erase the ledger.
    match /timeTrackingDeclarations/{declarationId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.driverEmail == request.auth.token.email
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.type in ['BREAK_START', 'BREAK_END']
        && request.resource.data.reason in ['PERSONAL_UNAVAILABLE', 'RETURNED_TO_WORK']
        && request.resource.data.source == 'driver_personal_declaration'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Driver-submitted notes and correction requests preserve the original
    // time snapshot. Only authorized reviewers may add a disposition.
    match /timeTrackingCorrectionRequests/{requestId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.driverEmail == request.auth.token.email
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.driverId is string
        && request.resource.data.date is string
        && request.resource.data.requestType in ['INCORRECT_TIME', 'MISSING_START', 'MISSING_END', 'SHIFT_NOTE']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'driver_same_view_request'
        && request.resource.data.originalSnapshot is map
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && isDispatcher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewerNote', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.status in ['resolved', 'rejected']
        && request.resource.data.reviewerNote is string
        && request.resource.data.reviewerNote.size() >= 3
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // Approved payroll records (admin/dispatcher finalize, driver can read own)
    match /payrollRecords/{recordId} {
      allow read: if signedIn() && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if signedIn() && isDispatcher();
      allow update: if signedIn() && isAdmin();
      allow delete: if signedIn() && isAdmin();
    }

    // Real-time Chat System Rules (Facebook Messenger Backend)
    match /chat_channels/{channelId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'readBy', 'unreadCounts', 'typing', 'mutedBy']);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 50 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['direct', 'group'];
      allow delete: if signedIn() && isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 10000 &&
          (!request.resource.data.keys().hasAny(['forwardedFrom']) ||
            request.resource.data.forwardedFrom.channelId is string);
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'deletedAt', 'deletedBy', 'reactions', 'pinned', 'pinnedBy', 'pinnedAt']) &&
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned', 'pinnedBy', 'pinnedAt']) || request.auth.uid == resource.data.senderId);
        allow delete: if signedIn() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
