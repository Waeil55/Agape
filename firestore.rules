rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isDispatcher() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin' || role == 'dispatcher';
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function validateTrip() {
      let data = request.resource.data;
      return data is map
        && data.keys().hasAll(['id', 'updatedAtLocal']);
    }
    function validateDriverProfile() {
      let data = request.resource.data;
      return data is map
        && data.keys().hasAny(['userId', 'email', 'name']);
    }
    function signedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function listHas(values, value) {
      return values is list && values.hasAny([value]);
    }
    function roleAllowed(roles) {
      return !(roles is list) || roles.size() == 0 || roles.hasAny([userRole()]);
    }
    function validGroupRoles(channelId, roles) {
      return roles is list && (
        (channelId == 'general' && roles.size() == 0) ||
        (channelId == 'dispatchers' && roles.hasAll(['admin', 'dispatcher']) && roles.hasOnly(['admin', 'dispatcher'])) ||
        (channelId == 'drivers' && roles.hasAll(['admin', 'driver', 'dispatcher']) && roles.hasOnly(['admin', 'driver', 'dispatcher'])) ||
        (channelId == 'admin' && roles.hasAll(['admin']) && roles.hasOnly(['admin']))
      );
    }
    function isKnownGroupChannel(channelId) {
      return channelId in ['general', 'dispatchers', 'drivers', 'admin'];
    }
    function isChatParticipant(data) {
      return listHas(data.dmParticipants, userEmail()) || listHas(data.participantIds, userEmail());
    }
    function canReadChannelData(data) {
      return signedIn() && (
        isAdmin() ||
        (data.type == 'dm' && isChatParticipant(data)) ||
        (data.type == 'group' && roleAllowed(data.roles))
      );
    }
    function canWriteChannelData(data) {
      return signedIn() && (
        (data.type == 'dm' && isChatParticipant(data)) ||
        (data.type == 'group' && roleAllowed(data.roles))
      );
    }
    function canReadChannel(channelId) {
      return canReadChannelData(get(/databases/$(database)/documents/chat_channels/$(channelId)).data);
    }
    function canWriteChannel(channelId) {
      return canWriteChannelData(get(/databases/$(database)/documents/chat_channels/$(channelId)).data);
    }
    function validChatChannelCreate(channelId) {
      let data = request.resource.data;
      return (
        isKnownGroupChannel(channelId) &&
        data.type == 'group' &&
        validGroupRoles(channelId, data.roles)
      ) || (
        channelId.matches('^dm_.*') &&
        data.type == 'dm' &&
        data.participantIds is list &&
        data.dmParticipants is list &&
        data.participantIds.size() == 2 &&
        data.dmParticipants.size() == 2 &&
        data.participantIds.hasAny([userEmail()]) &&
        data.dmParticipants.hasAny([userEmail()])
      );
    }
    function unreadBefore() {
      return resource.data.unreadByUid is map ? resource.data.unreadByUid : {};
    }
    function onlyOwnUnreadChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByUid']) &&
        request.resource.data.unreadByUid is map &&
        request.resource.data.unreadByUid.diff(unreadBefore()).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.unreadByUid[request.auth.uid] == 0;
    }
    function validChatMessageCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'channelId', 'senderUid', 'senderEmail', 'senderName', 'senderRole',
          'text', 'type', 'fileUrl', 'fileName', 'fileSize', 'fileType',
          'storagePath', 'timestamp', 'readBy', 'reactions'
        ]) &&
        data.keys().hasAll(['channelId', 'senderUid', 'senderEmail', 'text', 'type', 'timestamp']) &&
        data.senderUid == request.auth.uid &&
        data.senderEmail == userEmail() &&
        data.text is string &&
        data.text.size() <= 5000 &&
        data.type in ['text', 'image', 'file'] &&
        canWriteChannel(data.channelId);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isAdmin() || request.resource.data.role == 'driver');
      allow update: if request.auth != null && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if request.auth != null && isAdmin();
    }
    match /routeData/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /appData/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && docId != 'agape';
    }
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validateTrip();
      allow update: if request.auth != null && validateTrip();
      allow delete: if request.auth != null && isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow create: if false;
      allow update: if request.auth != null && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || request.resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || request.resource.data.driverId == request.auth.uid
      );
      allow delete: if false;
    }
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
    }
    match /heartbeat/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /system_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    match /chat_threads/{threadId} {
      allow read: if signedIn() && (
        isDispatcher() ||
        listHas(resource.data.participantIds, userEmail()) ||
        listHas(resource.data.participantIds, request.auth.uid)
      );
      allow create: if signedIn() && (
        listHas(request.resource.data.participantIds, userEmail()) ||
        listHas(request.resource.data.participantIds, request.auth.uid)
      );
      allow update: if signedIn() && (
        isDispatcher() ||
        listHas(resource.data.participantIds, userEmail()) ||
        listHas(resource.data.participantIds, request.auth.uid)
      );
      allow delete: if signedIn() && isAdmin();
    }
    match /chat_channels/{channelId} {
      allow read: if canReadChannelData(resource.data);
      allow create: if signedIn() && validChatChannelCreate(channelId);
      allow update: if signedIn() && (canWriteChannelData(resource.data) || isAdmin()) && onlyOwnUnreadChanged();
      allow delete: if signedIn() && isAdmin();
    }
    match /audit_logs/{auditId} {
      allow read: if request.auth != null && isDispatcher();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    match /tripLedger/{tripId} {
      allow read: if request.auth != null && isDispatcher();
      allow write: if request.auth != null && isDispatcher();
    }
    match /driverTripProgress/{tripId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /driverProfiles/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher()) && validateDriverProfile();
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher()) && validateDriverProfile();
      allow delete: if request.auth != null && isAdmin();
    }
    match /dispatcherProfiles/{dispatcherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    match /fleetVehicles/{vehicleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isDispatcher();
    }
    match /systemConfig/{document} {
      allow read: if request.auth != null && isDispatcher();
      allow write: if request.auth != null && isAdmin();
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /global_chat/{msgId} {
      allow read, write: if request.auth != null && isDispatcher();
    }
    match /chatData/{document} {
      allow read: if request.auth != null && isDispatcher();
      allow write: if request.auth != null && isDispatcher();
    }
    match /chat_messages/{msgId} {
      allow read: if signedIn() && canReadChannel(resource.data.channelId);
      allow create: if signedIn() && validChatMessageCreate();
      allow update: if signedIn() &&
        canWriteChannel(resource.data.channelId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy']);
      allow delete: if signedIn() && isAdmin();
    }
    match /presence/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && userEmail() == email;
    }
    match /chat_typing/{docId} {
      allow read: if signedIn() && canReadChannel(resource.data.channelId);
      allow write: if signedIn() &&
        request.resource.data.email == userEmail() &&
        canWriteChannel(request.resource.data.channelId);
    }
    match /driverTelemetry/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /chat_uploads/{fileId} {
      allow read: if signedIn() && isDispatcher();
      allow write: if signedIn() && isDispatcher();
    }
  }
}
