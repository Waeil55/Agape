rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isDispatcher() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin' || role == 'dispatcher';
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function signedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return request.auth.token.email;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isAdmin() || request.resource.data.role == 'driver');
      allow update: if request.auth != null && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if request.auth != null && isAdmin();
    }
    match /routeData/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /appData/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null && isDispatcher();
      allow update: if request.auth != null && (
        isDispatcher()
        || resource.data.driverEmail == request.auth.token.email
        || request.resource.data.driverEmail == request.auth.token.email
        || resource.data.userId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || request.resource.data.driverId == request.auth.uid
      );
      allow delete: if request.auth != null && isDispatcher();
    }
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (isDispatcher() || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
    }
    match /heartbeat/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /system_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /audit_logs/{auditId} {
      allow read: if request.auth != null && isDispatcher();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    match /tripLedger/{tripId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /driverTripProgress/{tripId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /driverProfiles/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }
    match /dispatcherProfiles/{dispatcherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isOwner(dispatcherId));
    }
    match /fleetVehicles/{vehicleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isDispatcher();
    }
    match /systemConfig/{document} {
      allow read: if request.auth != null && (isDispatcher() || document == 'phoneNumbers');
      allow write: if request.auth != null && isAdmin();
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isOwner(driverId) || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow update: if request.auth != null && (isOwner(driverId) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isDispatcher());
      allow delete: if request.auth != null && isAdmin();
    }

    match /presence/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && userEmail() == email;
    }

    match /chat_presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /driverTelemetry/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /analyticsLogs/{logId} {
      allow read: if request.auth != null && isDispatcher();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    // AI Dispatch + Time Tracking System — Section 10: real-time shift event log
    match /shiftEvents/{eventId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    // Section 10: GAP audit log — every gap generates a mandatory record
    match /gapAuditLog/{gapId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }
    // Section 18: Finalized time tracking sessions with payroll output
    match /timeTrackingSessions/{sessionId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || resource.data.driverId == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
    }
    // Approved payroll records (admin/dispatcher finalize, driver can read own)
    match /payrollRecords/{recordId} {
      allow read: if request.auth != null && (isDispatcher() || resource.data.driverId == request.auth.uid);
      allow create: if request.auth != null && isDispatcher();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Real-time Chat System Rules (Facebook Messenger Backend)
    match /chat_channels/{channelId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'readBy', 'unreadCounts', 'typing', 'mutedBy']);
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 50 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['direct', 'group'];
      allow delete: if request.auth != null && isAdmin();

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in getAfter(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 10000;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'deletedAt', 'deletedBy', 'reactions', 'pinned', 'pinnedBy', 'pinnedAt']) &&
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned', 'pinnedBy', 'pinnedAt']) || request.auth.uid == resource.data.senderId);
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
